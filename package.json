{
  "name": "end-comments",
  "version": "0.0.1",
  "scripts": {
    "compile": "tsc -p ./",
    "test": "vitest --config ./vitest.config.ts"
  },
  "main": "./build/extension.js",
  "engines": {
    "vscode": "^1.105.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "EndComments.CommentCurrent",
        "title": "End Comments: Add end comments in current file"
      },
      {
        "command": "EndComments.ViewLogs",
        "title": "End Comments: View Logs"
      }
    ]
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/vscode": "1.125.0",
    "typescript": "7.0.2",
    "vitest": "^4.1.10"
  }
}
